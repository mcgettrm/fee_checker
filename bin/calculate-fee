#!/usr/bin/env php
<?php
declare(strict_types=1);

require_once dirname(__DIR__) . '/vendor/autoload.php';

/**
 * Please note that you CAN modify this file in any way to suit your needs, but be advised that it MUST conform to
 * the contract specified in the README of the test.
 */

$amountString = $argv[1] ?? '';
$termString = $argv[2] ?? '';

try {
    if (!$amountString) {
        throw new \Exception("You must provide an amount\n");
    }

    if (!$termString) {
        throw new \Exception("You must provide a term\n");
    }

    $feeCalculator = new \Lendable\Interview\FeeCalculatorController(
            new \Lendable\Interview\FeeCalculatorService(
                    new \Lendable\Interview\Repositories\FeeStructureHardCodedRepository()
            ),
    );
    fwrite(STDOUT, $feeCalculator->getFeeForAmountAndTerm($amountString, $termString) . '\n');
    exit(0);
} catch (\Exception $e) {
    fwrite(STDERR, "Error: " . $e->getMessage() . "\n");
    exit(1);
}


