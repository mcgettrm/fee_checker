#!/usr/bin/env php
<?php
declare(strict_types=1);

require_once dirname(__DIR__) . '/vendor/autoload.php';

/**
 * Please note that you CAN modify this file in any way to suit your needs, but be advised that it MUST conform to
 * the contract specified in the README of the test.
 */

$amountString = $argv[1] ?? '';
$termString = $argv[2] ?? '';

try {
    $feeCalculator = new \Lendable\Interview\Controllers\FeeCalculatorController(
            new \Lendable\Interview\Services\FeeCalculatorService(
                    new \Lendable\Interview\Repositories\BreakPointHardCodedRepository(
                            new \Lendable\Interview\Factories\DefaultFeeStructureFactory()
                    )
            ),
    );
    fwrite(STDOUT, "{$feeCalculator->getFeeForAmountAndTerm($amountString, $termString)}" . PHP_EOL);
    exit(0);
} catch (\Exception $e) {
    fwrite(STDERR, "Error: " . $e->getMessage() . PHP_EOL);
    exit(1);
}


